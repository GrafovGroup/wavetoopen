# Read by your process manager. Secrets never go into client-side assets.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_TOKEN=
PORT=4317
HOST=127.0.0.1
# Public builds allow indexing by default; set false for preview builds.
SITE_INDEXABLE=true

# Optional build override after connecting an authorized custom domain.
SITE_ORIGIN=https://wavetoopen.ca
